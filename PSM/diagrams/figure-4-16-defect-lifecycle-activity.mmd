%% Figure 4.16 — Defect Lifecycle Activity Flow
%% B&W academic style, no figure title, Word-ready export

flowchart TD
    START([Create defect - status New])

    subgraph worker["Worker"]
        W1[Start assigned corrective action - In Progress]
        W2[Complete corrective action - Submitted Pending Review]
        W3[Submit suspected root cause - Suspected]
    end

    subgraph manager["Manager"]
        M1[Start review - Under Review]
        M2[Assign corrective action - Actions Assigned]
        M3{Verify action?}
        M4[Verify action - Verified]
        M5[Reject action - Rejected]
        M6{All non-cancelled CAs verified?}
        M7[Confirm root cause - Confirmed]
        M8[Close defect - Closed]
        DONE([Case closed])
    end

    START --> M1 --> M2 --> W1 --> W2 --> M3
    M3 -->|Verify| M4 --> M6
    M3 -->|Reject| M5 --> W1
    M6 -->|No| M2
    M6 -->|Yes| W3 --> M7 --> M8 --> DONE

    classDef bw fill:#ffffff,stroke:#000000,color:#000000,stroke-width:1.5px
    class START,W1,W2,W3,M1,M2,M3,M4,M5,M6,M7,M8,DONE bw
    style worker fill:#ffffff,stroke:#000000,stroke-width:1.5px,color:#000000
    style manager fill:#ffffff,stroke:#000000,stroke-width:1.5px,color:#000000
