%% Figure 4.3 — Defect Lifecycle (Word compact version)
%% Fewer lifelines — Loss Service folded into Corrective Action Module
%% Export SVG for Word A4 landscape, width ~24 cm

%%{init: {
  "theme": "base",
  "themeVariables": {
    "primaryColor": "#ffffff",
    "primaryTextColor": "#000000",
    "primaryBorderColor": "#000000",
    "lineColor": "#000000",
    "actorBkg": "#ffffff",
    "actorBorder": "#000000",
    "signalColor": "#000000",
    "noteBkgColor": "#ffffff",
    "noteBorderColor": "#000000",
    "fontFamily": "Arial, Helvetica, sans-serif",
    "fontSize": "14px"
  }
}}%%
sequenceDiagram
    autonumber

    actor Worker
    actor Manager
    participant UI as QDTS Interface
    participant Defect as Defect Module
    participant CA as Corrective Action Module
    participant DB as Database

    rect rgb(255, 255, 255)
        Note over Worker,DB: 1. Defect Reporting
        Worker->>UI: Report defect
        UI->>Defect: Create defect
        Defect->>DB: Insert (status = New)
        DB-->>Defect: Saved
        Defect-->>UI: Created
        Note right of Defect: qty_affected ≤ batch qty
    end

    rect rgb(255, 255, 255)
        Note over Worker,DB: 2. Review and Assignment
        Manager->>UI: Start review
        UI->>Defect: Under Review
        Defect->>DB: Update defect
        Manager->>UI: Assign action
        UI->>CA: Assign to worker
        CA->>DB: Insert action
    end

    rect rgb(255, 255, 255)
        Note over Worker,DB: 3. Action Completion
        Worker->>UI: Complete action
        UI->>CA: Submit completion
        CA->>CA: Validate quantities and calculate loss
        CA->>DB: Update action and defect
        CA-->>UI: Pending verification
    end

    rect rgb(255, 255, 255)
        Note over Worker,DB: 4. Verification and Closure
        Manager->>UI: Verify action
        UI->>CA: Verify
        CA->>DB: Status = Verified
        Manager->>UI: Confirm root cause
        UI->>Defect: Confirm
        Defect->>DB: Update investigation
        Manager->>UI: Close defect
        UI->>Defect: Close
        Defect->>DB: Status = Closed + activity log
        Note over Manager,DB: Close only after root cause confirmed and actions verified
    end
